                                        si5341: clock-generator@36 {
                                                compatible = "silabs,si5341";
                                                reg = <0x36>;
                                                #clock-cells = <0x2>;
                                                #address-cells = <0x1>;
                                                #size-cells = <0x0>;
                                                clocks = <&ref48>;
                                                clock-names = "xtal";
                                                clock-output-names = "si5341";
                                                phandle = <0xae>;

                                                si5341_0: out@0 {
                                                        reg = <0x0>;
                                                        always-on;
                                                        phandle = <0xf8>;
                                                };

                                                si5341_2: out@2 {
                                                        reg = <0x2>;
                                                        always-on;
                                                        phandle = <0xf9>;
                                                };

                                                si5341_3: out@3 {
                                                        reg = <0x3>;
                                                        always-on;
                                                        phandle = <0xfa>;
                                                };

                                                si5341_4: out@4 {
                                                        reg = <0x4>;
                                                        always-on;
                                                        phandle = <0xfb>;
                                                };

                                                si5341_5: out@5 {
                                                        reg = <0x5>;
                                                        always-on;
                                                        phandle = <0xfc>;
                                                };

                                                si5341_6: out@6 {
                                                        reg = <0x6>;
                                                        always-on;
                                                        phandle = <0xfd>;
                                                };

                                                si5341_7: out@7 {
                                                        reg = <0x7>;
                                                        always-on;
                                                        phandle = <0xfe>;
                                                };

                                                si5341_9: out@9 {
                                                        reg = <0x9>;
                                                        always-on;
                                                        phandle = <0xff>;
                                                };
                                        };
                                };

                                i2c@2 {
                                        #address-cells = <0x1>;
                                        #size-cells = <0x0>;
                                        reg = <0x2>;

                                        si570_1: clock-generator@5d {
                                                #clock-cells = <0x0>;
                                                compatible = "silabs,si570";
                                                reg = <0x5d>;
                                                temperature-stability = <0x32>;
                                                factory-fout = <0x11e1a300>;
                                                clock-frequency = <0x11e1a300>;
                                                clock-output-names = "si570_user";
                                                phandle = <0x100>;
                                        };
                                };

                                i2c@3 {
                                        #address-cells = <0x1>;
                                        #size-cells = <0x0>;
                                        reg = <0x3>;

                                        si570_2: clock-generator@5d {
                                                #clock-cells = <0x0>;
                                                compatible = "silabs,si570";
                                                reg = <0x5d>;
                                                temperature-stability = <0x32>;
                                                factory-fout = <0x9502f90>;
                                                clock-frequency = <0x9502f90>;
                                                clock-output-names = "si570_mgt";
                                                phandle = <0x101>;
                                        };
                                };

                                i2c@4 {
                                        #address-cells = <0x1>;
                                        #size-cells = <0x0>;
                                        reg = <0x4>;

                                        si5328: clock-generator@69 {
                                                compatible = "silabs,si5328";
                                                reg = <0x69>;
                                                #address-cells = <0x1>;
                                                #size-cells = <0x0>;
                                                #clock-cells = <0x1>;
                                                clocks = <&refhdmi>;
